# Copy to .env and edit. .env is git-ignored and must never be committed.

# --- source data ---------------------------------------------------------
# The Volve archive folder: 24 zips plus the licence PDF. Treated as READ-ONLY
# permanently — no target in this repo writes to it.
VOLVE_ARCHIVE_DIR=C:/Apply Kerja/DE/volve

# real      = the Volve archive on disk. The development default.
# synthetic = calibrated fixtures, for CI and load tests only. Numbers produced
#             in this mode are never presented as findings about Volve
#             (SPEC.md section 10 — a licence condition, not a preference).
SOURCE_MODE=real

# --- replay clock (BR-01) ------------------------------------------------
# The real UTC instant at which the replay starts. At this instant the replay
# stands at the first day of field life, 2008-06-01. There is no default: a
# clock that defaults to "today" makes every run's output depend on the day it
# ran. Set it once and leave it — moving it re-dates the whole replay.
REPLAY_EPOCH=2026-08-01T00:00:00Z

# Field months per real day. 1 = one field month per real day, so the field's
# whole 100-month life replays in 100 real days. 0.5 halves the pace, 2 doubles
# it. Exact decimals and fractions (1/3) are both accepted.
REPLAY_SPEED=1

# --- MinIO / S3 ----------------------------------------------------------
# Root credentials are what the MinIO container starts with, and what S3 clients
# use as access key / secret key. Change both before exposing the port.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=hugin
MINIO_ROOT_PASSWORD=change-me-before-first-run
MINIO_REGION=us-east-1
MINIO_BUCKET=hugin-lakehouse
